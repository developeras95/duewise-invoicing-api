# =====================================================================================
# Duewise: settings for `docker compose --profile app up`
# =====================================================================================
#
# HOW TO USE
#   1. Copy this file to .env in the same folder:
#        Windows:      copy .env.example .env
#        macOS/Linux:  cp .env.example .env
#   2. Uncomment (remove the leading "# ") and fill in only the lines you need.
#   3. Restart:  docker compose --profile app up -d
#      Check what the app will receive:  docker compose --profile app config
#
# .env is ignored by git: it may hold passwords. Never commit it; commit this
# .env.example instead, with placeholders only.
#
# Anything left commented out uses the default from compose.yaml, which is the local
# setup: PostgreSQL and Mailpit in Docker, every email visible at http://localhost:8025.
#
# FORMAT RULES
#   - One NAME=value per line, no spaces around "=".
#   - No quotes needed, even with spaces:  MAIL_FROM=Duewise <you@example.com>
#   - "#" starts a comment only at the beginning of a line.
#   - A "$" in a value must be written as "$$" (Compose treats "$" as a variable).
#
# HOW TO ADD ANOTHER SETTING
#   Docker Compose reads this file, not the application. A variable only reaches the
#   app if the app service in compose.yaml passes it on. To add one, for example
#   BUSINESS_NAME:
#     a) in compose.yaml, under services > app > environment, add
#          BUSINESS_NAME: ${BUSINESS_NAME:-Duewise Demo Studio}
#        (the part after ":-" is used when .env does not set it)
#     b) here, add  BUSINESS_NAME=Your Business Name
#   Every setting the app understands is listed in src/main/resources/application.yml
#   as ${NAME:default}.
#
# Running from IntelliJ instead of Docker? This file is not read there: set the same
# variables in Run > Edit Configurations > Environment variables.
# =====================================================================================


# ---- Ports on your computer ---------------------------------------------------------
# Change if 8080 or 5432 is already in use (e.g. the app is also running in IntelliJ).
# APP_PORT=8080
# POSTGRES_PORT=5432


# ---- Real email instead of Mailpit (all seven lines together) -----------------------
# Gmail: use an app password from https://myaccount.google.com/apppasswords
# (needs 2-Step Verification), 16 letters, no spaces. Never your normal password.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# SPRING_MAIL_USERNAME=you@gmail.com
# SPRING_MAIL_PASSWORD=your16letterapppassword
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM=Duewise <you@gmail.com>
#
# Careful: with real email on, every overdue invoice emails its client's billing
# address. Use test clients with addresses you own.


# ---- Your business on invoices and emails -------------------------------------------
# Printed on PDF invoices and in the footer ("Reply to ..."). Empty = not printed.
# BUSINESS_EMAIL=billing@yourbusiness.com
